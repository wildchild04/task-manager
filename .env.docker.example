# docker compose reads .env next to docker-compose.yml for these.

# Path the reverse proxy serves the app under (default /task-manager). Compiled into
# the image: rebuild after changing it. Caddy must keep the prefix (`handle`, not `handle_path`).
APP_BASE_PATH=/task-manager

# Time zone for chore schedules (default: America/Mexico_City).
TIME_ZONE=America/Mexico_City

# Shared secret for the agent API (/api/agent/*); the MCP server sends it. Off while empty.
# `just agent-token` generates one.
AGENT_TOKEN=
