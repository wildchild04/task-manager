# Copy to .env and adjust. Variables already set in the environment win.

# SQLite database file (default: data/app.sqlite).
# DATABASE_PATH=data/app.sqlite

# Folder for uploaded images (default: "content" beside the database, e.g. data/content).
# CONTENT_PATH=data/content

# Time zone for chore schedules (default: the server's).
# TIME_ZONE=Europe/Madrid

# Key agents' tokens are kept encrypted under, so Settings can show them again; at least 32 characters.
# Without it a token is shown once. `just secret-key` adds one to .env.
# SECRET_KEY=
